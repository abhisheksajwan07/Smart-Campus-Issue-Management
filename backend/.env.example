PORT=5000
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_campus

# JWT Authentication
JWT_SECRET=super_secret_smart_campus_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Python ML FastAPI Service
FASTAPI_URL=http://localhost:8000
FASTAPI_TIMEOUT_MS=5000

# Set to 'false' once your ML teammate starts FastAPI on port 8000
USE_MOCK_AI=true

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
