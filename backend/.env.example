PORT=5000
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_campus

# Redis Connection (Rate limiting, OTP storage, JWT token blacklist)
REDIS_URL=redis://localhost:6379

# Double Token JWT Authentication
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Resend Email Service (Leave blank to use automatic mock terminal logger)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Smart Campus <onboarding@resend.dev>

# Python ML FastAPI Service
FASTAPI_URL=http://localhost:8000
FASTAPI_TIMEOUT_MS=5000

# Set to 'false' once your ML teammate starts FastAPI on port 8000
USE_MOCK_AI=true

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
