          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gbu.ac.in\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "06 - Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me" }
          }
        },
        {
          "name": "07 - Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let token = pm.cookies.get('token');",
                  "if (!token) {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie');",
                  "  if (setCookie) {",
                  "    const match = setCookie.match(/token=([^;]+)/);",
                  "    if (match) token = match[1];",
                  "  }",
                  "}",
                  "if (!token) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.accessToken) {",
                  "    token = json.data.accessToken;",
                  "  }",
                  "}",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "none"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh-token" },
            "description": "Rotates access and refresh tokens. Postman sends the refreshToken httpOnly cookie automatically. No request body is required."
          }
        },
        {
          "name": "08 - Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('token', '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout" },
            "description": "Logs out user, clears httpOnly cookies, revokes session in Redis, and resets Postman token variable."
          }
        }
      ]
    },
    {
      "name": "02 - Complaints",
      "item": [
        {
          "name": "01 - Submit Complaint (AI Triage & SLA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.complaint && json.data.complaint.id) {",
                  "  pm.collectionVariables.set('sampleComplaintId', json.data.complaint.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ceiling fan making loud grinding noise and sparking\",\n  \"description\": \"The regulator is stuck and the fan smells like burnt plastic in room 302\",\n  \"location\": \"Hostel Block 1, Room 302\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/complaints" }
          }
        },
        {
          "name": "02 - List Complaints (Role-Scoped & Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/complaints?status=SUBMITTED&priority=CRITICAL",
              "query": [
                { "key": "status", "value": "SUBMITTED" },
                { "key": "priority", "value": "CRITICAL" },
                { "key": "category", "value": "Electrical", "disabled": true },
                { "key": "search", "value": "fan", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "03 - Get Single Complaint (Details & Timeline)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/complaints/{{sampleComplaintId}}" }
          }
        },
        {
          "name": "04 - Update Complaint Status (Staff & Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"note\": \"Technician dispatched to Room 302 to inspect the fan regulator\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/complaints/{{sampleComplaintId}}/status" }
          }
        },
        {
          "name": "05 - Human-in-the-Loop Override (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Electrical\",\n  \"priority\": \"CRITICAL\",\n  \"overrideReason\": \"Live sparking wires near mattress; escalating SLA to 6 hours immediately.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/complaints/{{sampleComplaintId}}/override" }
          }
        },
        {
          "name": "06 - Real-Time Server-Sent Events (SSE)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/complaints/stream?token={{token}}",
              "query": [{ "key": "token", "value": "{{token}}" }]
            }
          }
        }
      ]
