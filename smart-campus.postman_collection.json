{
  "info": {
    "name": "Smart Campus Issue Management API",
    "description": "Complete API Collection for Smart Campus Issue Management System (Node.js Express + Drizzle + PostgreSQL + FastAPI)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleComplaintId",
      "value": "",
      "type": "string"
    },
    {
      "key": "mlUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "01 - Verify GBU Enrollment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enrollmentNo\": \"23/SOBT/019\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-enrollment" }
          }
        },
        {
          "name": "02 - Register Student (with OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let token = pm.cookies.get('token');",
                  "if (!token) {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie');",
                  "  if (setCookie) {",
                  "    const match = setCookie.match(/token=([^;]+)/);",
                  "    if (match) token = match[1];",
                  "  }",
                  "}",
                  "if (!token) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.accessToken) {",
                  "    token = json.data.accessToken;",
                  "  }",
                  "}",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enrollmentNo\": \"23/SOBT/019\",\n  \"otp\": \"123456\",\n  \"password\": \"Password@123\",\n  \"hostelBlock\": \"Tagore Hostel\",\n  \"roomNo\": \"B-204\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register-student" }
          }
        },
        {
          "name": "03 - Login (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let token = pm.cookies.get('token');",
                  "if (!token) {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie');",
                  "  if (setCookie) {",
                  "    const match = setCookie.match(/token=([^;]+)/);",
                  "    if (match) token = match[1];",
