# Where the Vite dev server proxies /api and /uploads (backend Express server)
VITE_PROXY_TARGET=http://localhost:5000

# Leave empty to use the dev proxy (recommended).
# For a production build served from a different domain, set the backend origin,
# e.g. https://api.yourcampus.edu  (backend must then use COOKIE_SAMESITE=none + HTTPS)
VITE_API_URL=
